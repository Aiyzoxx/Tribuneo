# Configuration de la base de données PostgreSQL
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/siteliquidation?schema=public"

# Configuration Redis
REDIS_URL="redis://localhost:6379"

# Configuration du Backend API
PORT=3000

# Jeton de sécurité pour déclencher la synchronisation manuelle
SYNC_TOKEN="my-super-secret-token"

# Frontend Vite
VITE_API_URL="http://localhost:3000/api"

# Configuration SMTP (ex: Brevo / Sendinblue)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="votre_compte@brevo.com"
SMTP_PASSWORD="votre_mot_de_passe_smtp"
EMAIL_FROM="alertes@tribuneo.xyz"
